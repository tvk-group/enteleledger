{
  "id": "/",
  "name": "EnteleLEDGER — Permanent Record Portal",
  "short_name": "EnteleLEDGER",
  "description": "The permanent record and civilization-memory layer of the EnteleKRON ecosystem.",
  "start_url": "/app.html?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#030b17",
  "theme_color": "#071b3a",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "business",
    "productivity",
    "utilities"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "icons": [
    {
      "src": "/assets/brand/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/assets/brand/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/brand/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/brand/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Record Explorer",
      "short_name": "Explorer",
      "description": "Browse permanent-record categories.",
      "url": "/explorer.html?source=pwa",
      "icons": [
        {
          "src": "/assets/brand/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Record Flow",
      "short_name": "Flow",
      "description": "Review how events become permanent records.",
      "url": "/flow.html?source=pwa",
      "icons": [
        {
          "src": "/assets/brand/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Trust Architecture",
      "short_name": "Trust",
      "description": "Open the EnteleLEDGER trust architecture.",
      "url": "/trust.html?source=pwa",
      "icons": [
        {
          "src": "/assets/brand/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Full EnteleLEDGER Site",
      "short_name": "Website",
      "description": "Open the complete EnteleLEDGER website.",
      "url": "/?source=pwa",
      "icons": [
        {
          "src": "/assets/brand/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
